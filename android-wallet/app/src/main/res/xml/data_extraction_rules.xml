<?xml version="1.0" encoding="utf-8"?>
<!-- The wallet holds private keys; never let it leave the device via backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
